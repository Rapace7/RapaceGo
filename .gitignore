# ============================================================
#  InfiniGo（玄清围弈）· 不进入仓库的东西
# ============================================================

# ---------- 依赖：别人自己 npm install ----------
node_modules/

# ---------- 本机运行时产物 ----------
# settings.json 里存的是**你本机的引擎绝对路径**（设置面板保存时生成）。
# 发出去等于把自己的盘符结构公开，而且别人拿到也没用（路径不一样）。
settings.json

# 引擎日志（每次跑 KataGo 都会写）
engine-logs/

# 棋谱库（你的真实对局，涉及隐私）
records/

# 开发期的临时产物：测试截图 / 中间日志 / 探针脚本
_trash/

# 测试脚本吐在根目录的截图（_cdp_xxx.mjs 的副产物）。
# ⚠️ 只忽略截图，**不忽略 `_*.mjs`** —— 那批测试脚本是刻意进仓库的
# （见 现状与待办.md「怎么验证改动没坏东西」），将来别人接手能直接跑。
/_.*.png

# 提交信息临时文件（用 git commit -F 传多行说明用，用完即删；
# ★ 踩过：有一次 add -A 在删它之前跑，把这个临时文件也提交进去了）
_cm.txt

# 打包输出（electron-builder 生成，发布时传 Release，不进仓库）
dist/

# Release 说明（由 dev\_mk_notes.mjs 从 docs\发布说明.md 生成，发布时用，不进仓库）
# ★ 踩过（2026-10-09）：它是生成物，我却用 `git add -A` 把它提交进去了
_release_notes.md

# ---------- 系统生成的垃圾 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---------- 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo

# ★ 2026-10-09 补：_cm.txt 早就忽略了，但改用 _commit_msg.txt 时忘了加 —— 又提交进去一次。
#   教训：任何「用完即删的临时文件」，要一次把所有命名变体都写进 .gitignore。
_commit_msg.txt
_*.tmp

# ★★ 2026-10-09：提交信息临时文件 —— 这个坑踩了**三次**
#   _cm.txt → 忽略了；改用 _commit_msg.txt → 又提交；改用 _cmsg.txt → 又提交。
#   教训：别一个个加名字，**用通配符一次覆盖所有变体**（下面这行）。
_*msg*.txt
_*.tmp

# ★★ 2026-10-14：`dev/` 目录下的**本机调试产物**。
#   原来上面那条 `/_.*.png` 只挡根目录的截图 —— `dev/` 下的一律漏网，
#   于是 `git add -A` 会把调试 profile（8 MB 的 Electron 缓存）、
#   临时截图、跑测日志一起提交进去。这里逐类挡掉：
#     · _dbg_profile / _unpacked_profile —— Electron 的 --user-data-dir（缓存 + GPU 着色器）
#     · _cdp_start.log / _regress_*.txt —— 跑一次写一次的日志
#     · _*.png —— 探针截的图（产品用的截图在 docs/screenshots/，不受影响）
#   ⚠️ 刻意**不**忽略 `.mjs` / `.js`：那批探针脚本是要进仓库的（别人接手能直接跑）。
dev/_dbg_profile/
dev/_unpacked_profile/
dev/_cdp_start.log
dev/_regress_out.txt
dev/_regress_err.txt
dev/_fix_layout_fn.txt
dev/_*.png
